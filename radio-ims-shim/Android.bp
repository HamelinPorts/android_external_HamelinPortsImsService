// SPDX-License-Identifier: Apache-2.0

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.radio.ims-service.hamelinports_shim",
    relative_install_path: "hw",
    init_rc: ["android.hardware.radio.ims.shim.rc"],
    vintf_fragments: ["android.hardware.radio.ims.shim.xml"],
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    shared_libs: [
        "android.hardware.radio-V4-ndk",
        "android.hardware.radio.ims-V3-ndk",
        "libbase",
        "libbinder_ndk",
        "libutils",
    ],
    srcs: [
        "RadioImsShim.cpp",
        "main.cpp",
    ],
}
