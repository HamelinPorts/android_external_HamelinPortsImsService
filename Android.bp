package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "HamelinPortsImsService",
    srcs: ["src/**/*.java"],
    asset_dirs: ["assets"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    jni_libs: ["libhamelinports_ims_jni"],
    use_embedded_native_libs: true,
    /* ImsMediaFramework is an android_library (not an SDK jar) that
     * exports android.telephony.imsmedia.*; static_libs pulls the
     * classes into our APK so HamelinPortsImsMediaSession can link them. */
    static_libs: [
        "ImsMediaFramework",
        "hamelinports-ims-aidl",
    ],
    required: ["privapp-permissions-org.hamelinports.ims"],
    optimize: {
        enabled: false,
    },
}

// Host unit tests of the registration policy, slot activation, the IWLAN
// DPD interval and the Security-Client offer (pure Java, no device):
//   atest --host HamelinPortsImsPolicyTests
java_test_host {
    name: "HamelinPortsImsPolicyTests",
    srcs: [
        "src/org/hamelinports/ims/config/*.java",
        "src/org/hamelinports/ims/reg/*.java",
        "src/org/hamelinports/ims/sip/SecurityClientOffer.java",
        "tests/host/src/**/*.java",
    ],
    static_libs: ["junit"],
    test_options: {
        unit_test: true,
    },
}

// Host test of how the JNI socket hook discards a SIP socket it cannot pin:
//   atest --host HamelinPortsImsSocketDiscardTest
cc_test_host {
    name: "HamelinPortsImsSocketDiscardTest",
    srcs: ["tests/host/native/sip_socket_discard_test.cpp"],
    local_include_dirs: ["jni"],
    gtest: false,
    test_options: {
        unit_test: true,
    },
}

// Host test of the socket()/connect() guard, linked with the same wrap flags
// as the JNI library:
//   atest --host HamelinPortsImsSocketGuardTest
cc_test_host {
    name: "HamelinPortsImsSocketGuardTest",
    srcs: [
        "tests/host/native/sip_socket_guard_test.cpp",
        "jni/sip_socket_guard.cpp",
    ],
    local_include_dirs: ["jni"],
    ldflags: [
        "-Wl,--wrap=socket",
        "-Wl,--wrap=connect",
    ],
    gtest: false,
    test_options: {
        unit_test: true,
    },
}

// Native bridge into reSIProcate. Scaffolding — the Java SipClient
// still handles all real traffic. See jni/hamelinports_ims_jni.cpp.
cc_library_shared {
    name: "libhamelinports_ims_jni",
    srcs: [
        "jni/hamelinports_ims_jni.cpp",
        "jni/sip_socket_guard.cpp",
    ],
    // Every socket() and connect() in this library, reSIProcate and c-ares
    // included, goes through jni/sip_socket_guard.cpp: an IP socket the SIP
    // socket hook did not pin to the IMS network cannot connect.
    ldflags: [
        "-Wl,--wrap=socket",
        "-Wl,--wrap=connect",
    ],
    cppflags: [
        "-std=gnu++17",
        "-fexceptions",
    ],
    cflags: [
        // Pulling in reSIProcate headers triggers a blob of upstream
        // style warnings that AOSP turns into errors. Quiet them for
        // this consumer without poking each header.
        "-Wno-error=non-virtual-dtor",
        "-Wno-non-virtual-dtor",
        "-Wno-ignored-qualifiers",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],
    rtti: true,

    // whole_static_libs pulls dum → stack → rutil transitively. Listing
    // the other two here would double-link and cause duplicate symbols.
    whole_static_libs: [
        "libresip_dum",
    ],
    static_libs: [
        "libcares",
    ],
    shared_libs: [
        "libandroid", // android_setsocknetwork: pins SIP sockets to the IMS network
        "liblog",
        "libssl",
        "libcrypto",
    ],

    stl: "c++_shared",
}

cc_binary {
    name: "ims_xfrm",
    srcs: ["ims_xfrm/ims_xfrm.c"],
    cflags: ["-Wall", "-Werror"],
    init_rc: ["ims_xfrm.rc"],
}

prebuilt_etc {
    name: "privapp-permissions-org.hamelinports.ims",
    filename: "privapp-permissions-org.hamelinports.ims.xml",
    src: "privapp-permissions-org.hamelinports.ims.xml",
    sub_dir: "permissions",
}

cc_binary {
    name: "portS_test",
    srcs: ["ims_oemipc/portS_test.c"],
    cflags: ["-Wall"],
}
